[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/colony_hud.gd" id="1_hud"]

[sub_resource type="StyleBoxFlat" id="BarStyle"]
bg_color = Color(0.055, 0.075, 0.06, 0.96)
border_width_bottom = 1
border_color = Color(0.29, 0.36, 0.27, 1)

[sub_resource type="ButtonGroup" id="SpeedGroup"]

[node name="ColonyHUD" type="CanvasLayer"]
process_mode = 3
script = ExtResource("1_hud")

[node name="Bar" type="PanelContainer" parent="."]
anchors_preset = 10
anchor_right = 1.0
offset_bottom = 48.0
grow_horizontal = 2
theme_override_styles/panel = SubResource("BarStyle")

[node name="Margin" type="MarginContainer" parent="Bar"]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 6

[node name="Contents" type="HBoxContainer" parent="Bar/Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Pause" type="Button" parent="Bar/Margin/Contents"]
custom_minimum_size = Vector2(64, 32)
layout_mode = 2
focus_mode = 0
toggle_mode = true
text = "Pause"

[node name="Speed0" type="Button" parent="Bar/Margin/Contents"]
layout_mode = 2
focus_mode = 0
toggle_mode = true
button_pressed = true
button_group = SubResource("SpeedGroup")
text = "1x"

[node name="Speed1" type="Button" parent="Bar/Margin/Contents"]
layout_mode = 2
focus_mode = 0
toggle_mode = true
button_group = SubResource("SpeedGroup")
text = "2x"

[node name="Speed2" type="Button" parent="Bar/Margin/Contents"]
layout_mode = 2
focus_mode = 0
toggle_mode = true
button_group = SubResource("SpeedGroup")
text = "4x"

[node name="Separator" type="VSeparator" parent="Bar/Margin/Contents"]
layout_mode = 2

[node name="AntCount" type="Label" parent="Bar/Margin/Contents"]
layout_mode = 2
text = "Ants  0"

[node name="TotalFood" type="Label" parent="Bar/Margin/Contents"]
layout_mode = 2
text = "Food  0"

[node name="StoredFood" type="Label" parent="Bar/Margin/Contents"]
layout_mode = 2
text = "Stored  0"

[node name="Spacer" type="Control" parent="Bar/Margin/Contents"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="Warning" type="Label" parent="Bar/Margin/Contents"]
layout_mode = 2
text = "No food"

[node name="AddFood" type="Button" parent="Bar/Margin/Contents"]
layout_mode = 2
focus_mode = 0
toggle_mode = true
text = "Place orange"
tooltip_text = "Choose a clear spot on the ground, then click to drop an orange."

[node name="PlacementHint" type="Label" parent="."]
visible = false
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = -40.0
offset_bottom = -12.0
grow_horizontal = 2
grow_vertical = 0
mouse_filter = 2
text = "Click clear ground to drop an orange · Green = clear · Red = blocked · Esc / right-click to cancel"
horizontal_alignment = 1
